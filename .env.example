# NFL Analytics - Environment Variables Template
# Copy this file to .env and replace placeholder values with actual credentials
# IMPORTANT: Never commit .env with real credentials to version control

# ============================================================================
# Database Configuration
# ============================================================================
# PostgreSQL connection details
DB_HOST=localhost
DB_PORT=5544
DB_NAME=devdb01
DB_USER=dro
DB_PASSWORD=CHANGE_ME

# Connection Pool Settings (Repository Pattern)
DB_MIN_CONNECTIONS=5
DB_MAX_CONNECTIONS=50
DB_TIMEOUT=30

# Optional: Full database URL (alternative to above)
DATABASE_URL=postgresql://dro:CHANGE_ME@localhost:5544/devdb01

# ============================================================================
# External APIs
# ============================================================================
# Odds data API key (RapidAPI or equivalent)
ODDS_API_KEY=CHANGE_ME

# NFL.com or ESPN API key (if needed)
NFL_API_KEY=CHANGE_ME

# Weather API (OpenWeather, WeatherAPI, etc)
WEATHER_API_KEY=CHANGE_ME

# ============================================================================
# Claude Integration (MCP Server)
# ============================================================================
# Anthropic Claude API key
ANTHROPIC_API_KEY=CHANGE_ME

# Apify web scraping API key
APIFY_API_KEY=CHANGE_ME

# GitHub API token for repository operations
GITHUB_TOKEN=CHANGE_ME

# ESPN API base URL
ESPN_API_BASE_URL=https://site.api.espn.com

# ============================================================================
# Google Drive Integration
# ============================================================================
# Path to Google service account credentials JSON
GOOGLE_CREDENTIALS_PATH=CHANGE_ME

# Google Drive folder ID for syncing trained models
GOOGLE_DRIVE_FOLDER_ID=CHANGE_ME

# ============================================================================
# Compute System Configuration
# ============================================================================
# Hardware type: 'mac' (M4), 'windows' (RTX 4090), or 'auto' for detection
HARDWARE_TYPE=auto

# Max CPU threads for parallel processing
MAX_CPU_THREADS=8

# GPU memory limit (GB) for CUDA operations
GPU_MEMORY_LIMIT=20

# Task queue type: 'sqlite' (default), 'postgresql', 'redis'
TASK_QUEUE_TYPE=sqlite

# ============================================================================
# Model & Training Configuration
# ============================================================================
# Directory for model artifacts
MODELS_DIR=models

# Directory for training outputs and logs
TRAINING_LOGS_DIR=analysis/training_logs

# Random seed for reproducibility (integer or null for random)
RANDOM_SEED=42

# Number of MCMC chains for Bayesian models
MCMC_CHAINS=4

# MCMC iterations per chain
MCMC_ITERATIONS=2000

# ============================================================================
# Redis Cache Configuration
# ============================================================================
# Redis server connection for caching
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Redis authentication (REQUIRED for security)
# Change this to a strong password in production!
REDIS_PASSWORD=changeme_redis_password

# Cache TTL in seconds (default 604800 = 7 days)
REDIS_CACHE_TTL=604800

# ============================================================================
# API Configuration
# ============================================================================
# API server host binding
API_HOST=0.0.0.0

# API server port
API_PORT=8000

# Enable hot reload (development only)
API_RELOAD=false

# CORS allowed origins (comma-separated)
CORS_ORIGINS=*

# HTTP cache TTL in seconds
CACHE_TTL_SECONDS=3600

# MCP Server Configuration
MCP_SERVER_PORT=3000
MCP_LOG_LEVEL=INFO

# ============================================================================
# Real-Time Odds Service
# ============================================================================
# Polling interval for odds updates (seconds)
ODDS_POLL_INTERVAL=900

# Line movement alert threshold (points)
LINE_MOVE_THRESHOLD=5.0

# Webhook URL for line movement alerts
ALERT_WEBHOOK_URL=CHANGE_ME

# ============================================================================
# Email Notifications
# ============================================================================
# SMTP configuration for trade settlement alerts
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME

# Alert recipient email address
ALERT_EMAIL=dro@example.com

# ============================================================================
# Monitoring & Logging
# ============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log directory
LOG_DIR=logs

# Prometheus metrics endpoint (for monitoring)
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=8000

# ============================================================================
# Development & Testing
# ============================================================================
# Environment: production, staging, development
ENVIRONMENT=development

# Enable debug mode
DEBUG=true

# Run data validation checks on startup
VALIDATE_DATA_ON_STARTUP=true

# Path to test database (if different from main)
TEST_DATABASE_URL=postgresql://dro:CHANGE_ME@localhost:5544/testdb

# ============================================================================
# Grafana Dashboard Configuration
# ============================================================================
# Grafana admin password
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# ============================================================================
# R Configuration
# ============================================================================
# R logging directory for ETL scripts
R_LOG_DIR=logs/r_etl

# ============================================================================
# Deployment Configuration
# ============================================================================
# Docker registry for pushing images
DOCKER_REGISTRY=CHANGE_ME

# Docker image tag
DOCKER_IMAGE_TAG=latest

# Kubernetes cluster context (for k8s deployments)
KUBE_CONTEXT=CHANGE_ME
