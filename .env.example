# Variables the code in this repository reads. Copy to .env (git-ignored) and fill in.
# Only scripts/backfill_historical_odds.py and scripts/extract_international_games.py load .env
# themselves (python-dotenv); for everything else, export the variables in your shell.
# The local database's dev password is in docker-compose.yml (dev only, public).

# Database: nfl_analytics/config/settings.py, utils/db_config.py, the feature modules, most
# scripts, and scripts/maintenance/{backup,restore}.sh
DB_HOST=localhost
DB_PORT=5544
DB_NAME=devdb01
DB_USER=dro
DB_PASSWORD=CHANGE_ME

# The same connection under other names:
# POSTGRES_* in features/asof_features*.py, models/state_space.py,
# analysis/validation/validate_injury_weights.py, scripts/backfill_historical_odds.py, tests/
POSTGRES_HOST=localhost
POSTGRES_PORT=5544
POSTGRES_DB=devdb01
POSTGRES_USER=dro
POSTGRES_PASSWORD=CHANGE_ME
# NFL_DB_* in models/power_ratings_model.py (database mode only)
NFL_DB_HOST=localhost
NFL_DB_PORT=5544
NFL_DB_NAME=devdb01
NFL_DB_USER=dro
NFL_DB_PASSWORD=CHANGE_ME

# Integration tests (tests/conftest.py db_connection): a scratch database, not devdb01
TEST_DATABASE_URL=postgresql://dro:CHANGE_ME@localhost:5544/testdb

# The Odds API key, for scripts/backfill_historical_odds.py only. Never commit a real key.
ODDS_API_KEY=CHANGE_ME

# Optional
# GAME_OUTCOME_TABLE=ml.game_outcome_predictions  # nfl_analytics/services/game_outcome_runs.py
# GAME_OUTCOME_TARGET_SEASON=2026                  # scripts/generate_2025_game_predictions_fixed.py
# BACKUP_DIR=${HOME}/nfl-analytics-backups         # scripts/maintenance/{backup,restore}.sh
# MAX_BACKUPS=30                                   # scripts/maintenance/backup.sh
# TIMESCALEDB_VERSION=2.24.0                       # scripts/maintenance/restore.sh
