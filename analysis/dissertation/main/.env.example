# NFL Analytics - Environment Configuration Template
# Copy this file to .env and update with your actual values

# ============================================
# PostgreSQL/TimescaleDB Configuration
# ============================================
POSTGRES_DB=nfl_analytics
POSTGRES_USER=nfl
POSTGRES_PASSWORD=nfl_secure_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ============================================
# Dashboard Configuration
# ============================================
DASHBOARD_PORT=8501

# ============================================
# API Configuration
# ============================================
API_PORT=8000

# ============================================
# Training Configuration
# ============================================
TRAINING_EPOCHS=100
BATCH_SIZE=32
LEARNING_RATE=0.001

# ============================================
# Backtest Configuration
# ============================================
BACKTEST_START_SEASON=2020
BACKTEST_END_SEASON=2024
INITIAL_BANKROLL=10000

# ============================================
# RL Training Configuration
# ============================================
RL_AGENT_TYPE=dqn
RL_NUM_EPISODES=5000
RL_BATCH_SIZE=64
RL_LEARNING_RATE=0.0001
