# Ignore nested repo
/data/nflverse-data/
pgdata/
.env
# Note: .env.example IS tracked - it's the template for configuration
.tmp.driveupload/

# Worker logs
*.log
!archive/**/*.log

# Redis data
dump.rdb

# Compute databases
compute_queue.db*
machine_info.json

# macOS system files
.DS_Store
._*
.Spotlight-V100
.Trashes

# Local temp downloads
.tmp.drivedownload/

# Editor/IDE settings
.idea/
.vscode/
*.code-workspace

# Docker config files
.dockerignore
# Note: .gitattributes IS tracked (needed for Git LFS)

# GitHub workflows (sensitive automation) - REMOVED to allow CI/CD workflows
# .github/workflows/

# Claude local context
.claude/
.claude_context

# Python caches and coverage
__pycache__/
*.py[cod]
*.so
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.ipynb_checkpoints/
.cache/

# R and renv artifacts
.Rhistory
.RData
.Ruserdata
.Rproj.user/
.Rprofile
renv.lock
renv/library/
renv/staging/

# Notebook/Quarto/knitr caches
**/*_cache/
**/*_files/
**/_freeze/
# Compiled notebook HTML (keep sources under notebooks/)
notebooks/**/*.html

# Generic local databases
*.sqlite3
*.db
*.db-shm
*.db-wal

# Build artifacts
dist/
build/
.eggs/
*.egg-info/
pip-wheel-metadata/
# Analysis temporary CSVs
analysis/results/*_tmp.csv

# Virtual environments
.venv/
venv/
env/
.direnv/

