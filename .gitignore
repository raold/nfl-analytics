results/
predictions/
logs/r_etl/

# Allow README files in ignored dirs
!results/README.md
!predictions/README.md

# Processed datasets
data/processed/
data/rl_logged_*.csv

# Experiment/evaluation data (regenerated by running scripts)
data/*_holdout_evaluation_*.csv
data/ab_test_*.json
data/best_xgb_config.json
data/feature_importance_*.csv
data/feature_optimization_*.txt
data/feature_optimization_*.csv
data/feature_weighting_experiment.csv
data/game_predictions_*.csv
data/week*_predictions_*.csv

# Semantic training data (large, regenerated by annotation pipeline)
data/semantic_training/

# Allow README in data/processed
!data/processed/README.md

# Model binaries and sweep outputs (use Git LFS for binaries)
models/**/*.pth
models/**/*.pkl
models/**/*.ubj
models/**/sweep/*.csv
# Model run logs/metadata (derived)
models/**/metrics_history*.jsonl
models/**/*_training_log.json
models/**/sweep/*.json

# Model checkpoints (large files)
checkpoints/
sweeps/

# Experiment/ablation model artifacts (regenerated by running experiments)
# Reorganized Dec 23, 2025 - see models/README.md
models/archive/
models/staging/
models/experiments/**/*.pth
models/experiments/**/*.pkl

# Large model files (keep only metadata)
models/archive/rl_experiments/cql/*/best_checkpoint.pth
models/archive/rl_experiments/cql/*/optimizer_state.pth

# Analysis artifacts
analysis/**/*.log
analysis/**/*.aux
analysis/**/*.out
analysis/**/*.fls
analysis/**/*.fdb_latexmk

# Temporary/old scripts
*_old.sh
*_backup.sh
check_*.sh

# Temporary documentation (actual docs go in docs/)
*_STATUS.md
*_SUMMARY.md
*_EXECUTION*.md
!CLAUDE.md
!README.md
!SETUP.md
!CONTRIBUTING.md
!PROJECT_STATUS.md
!PHASE_PLAN.md
!AGENTS.md

# Hypothesis testing cache
.hypothesis/

# Backup files (prevent tracking of .bak and .backup files)
*.bak
*.backup

# Database backups (tracked via Git LFS)
backups/*
!backups/*.dump
!backups/README.md
# Large models (>2GB) - store externally, regenerate from training
models/bayesian/simplified_random_walk_v2.rds
models/bayesian/simplified_random_walk_v1.rds

# Generated files
Rplots.pdf
ensemble_status.json
temporal_safety_report.json
