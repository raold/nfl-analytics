# ============================================================================
# Dockerfile for NFL Analytics Odds Fetcher Service
# ============================================================================
#
# This container runs the real-time odds update service that continuously
# polls The Odds API and updates the database with current betting lines.
#
# Build:
#   docker build -f containers/Dockerfile.odds-fetcher -t nfl-analytics-odds-fetcher .
#
# Run:
#   docker run -e ODDS_API_KEY=your_key nfl-analytics-odds-fetcher
#
# Author: Claude Code (Sonnet 4.5)
# Date: November 8, 2025
# ============================================================================

FROM python:3.11-slim

LABEL maintainer="NFL Analytics Research"
LABEL description="Real-time odds fetching service for NFL Analytics"
LABEL version="1.0"

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    postgresql-client \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY py/data/odds_update_service.py py/data/odds_update_service.py
COPY py/data/fetch_prop_odds.py py/data/fetch_prop_odds.py

# Create logs directory
RUN mkdir -p /app/logs/odds

# Set environment variables (can be overridden at runtime)
ENV PYTHONUNBUFFERED=1
ENV LOG_LEVEL=INFO
ENV POLL_INTERVAL=900
ENV LINE_MOVE_THRESHOLD=5.0

# Health check: Verify service is responsive
HEALTHCHECK --interval=5m --timeout=10s --start-period=30s --retries=3 \
    CMD test -f /app/logs/odds/odds_service_$(date +%Y%m%d).log && \
        test $(find /app/logs/odds/odds_service_$(date +%Y%m%d).log -mmin -10 | wc -l) -gt 0 || exit 1

# Run service
CMD ["python", "py/data/odds_update_service.py"]
