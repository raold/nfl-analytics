# Dockerfile.gpu-trainer - NFL Analytics GPU Training Container
# Purpose: Reproducible GPU training environment for RTX 4090 and similar CUDA GPUs
# Build: docker build -f containers/Dockerfile.gpu-trainer -t nfl-analytics-gpu-trainer .
# Run: See docker-compose.gpu.yml for full configuration
#
# Features:
# - NVIDIA CUDA 12.2 with cuDNN 8 for deep learning
# - PyTorch 2.5+ with CUDA support
# - XGBoost with GPU acceleration
# - R 4.4+ with brms, cmdstanr, and Stan
# - Complete Python ML/statistical stack
# - Supports BNN, XGBoost, and hierarchical Bayesian training

# ============================================================================
# Stage 1: Base CUDA Environment
# ============================================================================
FROM nvidia/cuda:12.2.0-cudnn8-devel-ubuntu22.04 AS base

# Avoid interactive prompts during build
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=America/Chicago

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Build essentials
    build-essential \
    cmake \
    git \
    wget \
    curl \
    ca-certificates \
    # Python 3.11 (for compatibility with existing codebase)
    software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
    python3.11 \
    python3.11-dev \
    python3.11-distutils \
    python3-pip \
    # Database client libraries
    libpq-dev \
    postgresql-client \
    # Numerical libraries
    libopenblas-dev \
    liblapack-dev \
    # For R compilation
    gfortran \
    libbz2-dev \
    liblzma-dev \
    libpcre3-dev \
    libcurl4-openssl-dev \
    libssl-dev \
    libxml2-dev \
    # System monitoring
    htop \
    nvtop \
    && rm -rf /var/lib/apt/lists/*

# Make Python 3.11 the default
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1 \
    && update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1

# Install pip for Python 3.11
RUN curl -sS https://bootstrap.pypa.io/get-pip.py | python3.11

# ============================================================================
# Stage 2: Python ML Environment
# ============================================================================
FROM base AS python-ml

WORKDIR /tmp

# Install uv for fast Python package management
RUN pip install --no-cache-dir uv

# Copy requirements files
COPY requirements.txt /tmp/

# Install PyTorch with CUDA 12.2 support (from official PyTorch index)
RUN uv pip install --system --no-cache \
    torch==2.5.1 \
    torchvision==0.20.1 \
    torchaudio==2.5.1 \
    --index-url https://download.pytorch.org/whl/cu121

# Install core ML and data science packages
RUN uv pip install --system --no-cache \
    # Core requirements from requirements.txt
    pandas>=2.0.0 \
    polars>=0.19.0 \
    pyarrow>=14.0.0 \
    numpy>=2.0.0 \
    scipy>=1.11.0 \
    scikit-learn>=1.3.0 \
    # XGBoost with GPU support
    xgboost>=2.0.0 \
    # Bayesian/probabilistic programming
    pymc>=5.10.0 \
    arviz>=0.17.0 \
    numpyro>=0.13.0 \
    jax[cuda12]>=0.4.20 \
    # Database
    SQLAlchemy>=2.0.0 \
    psycopg[binary]>=3.1.0 \
    # Visualization
    matplotlib>=3.8.0 \
    seaborn>=0.13.0 \
    plotly>=5.18.0 \
    # Redis (for distributed compute)
    redis>=4.5.0 \
    # Utilities
    python-dotenv>=1.0.0 \
    tqdm>=4.66.0 \
    loguru>=0.7.0 \
    typer>=0.9.0 \
    # Model optimization
    optuna>=3.5.0 \
    # System monitoring
    psutil>=5.9.0 \
    pynvml>=11.5.0

# Verify PyTorch CUDA support
RUN python -c "import torch; assert torch.cuda.is_available(), 'CUDA not available in PyTorch'; print(f'PyTorch {torch.__version__} with CUDA {torch.version.cuda}')"

# Verify XGBoost CUDA support
RUN python -c "import xgboost as xgb; print(xgb.build_info()); assert xgb.build_info().get('USE_CUDA', False), 'XGBoost not built with CUDA'"

# ============================================================================
# Stage 3: R Statistical Environment with Stan
# ============================================================================
FROM python-ml AS r-stan

WORKDIR /tmp

# Install R 4.4+ from CRAN
RUN wget -qO- https://cloud.r-project.org/bin/linux/ubuntu/marutter_pubkey.asc | tee -a /etc/apt/trusted.gpg.d/cran_ubuntu_key.asc \
    && echo "deb https://cloud.r-project.org/bin/linux/ubuntu jammy-cran40/" >> /etc/apt/sources.list.d/cran.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
    r-base \
    r-base-dev \
    && rm -rf /var/lib/apt/lists/*

# Install system dependencies for R packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgdal-dev \
    libudunits2-dev \
    libgeos-dev \
    libproj-dev \
    && rm -rf /var/lib/apt/lists/*

# Install R packages (single RUN for better caching)
# This is the comprehensive set needed for Bayesian hierarchical models
RUN R -e "install.packages(c( \
    'remotes', \
    'tidyverse', \
    'data.table', \
    'brms', \
    'cmdstanr', \
    'posterior', \
    'bayesplot', \
    'loo', \
    'tidybayes', \
    'rstanarm', \
    'RPostgres', \
    'DBI', \
    'jsonlite', \
    'arrow', \
    'furrr' \
), repos='https://cloud.r-project.org/')"

# Install CmdStan (Stan's command-line interface)
# This is required for brms and cmdstanr
RUN R -e "cmdstanr::install_cmdstan(cores = parallel::detectCores(), overwrite = TRUE)"

# Verify Stan installation
RUN R -e "library(cmdstanr); cmdstanr::cmdstan_version()"

# ============================================================================
# Stage 4: Final Training Environment
# ============================================================================
FROM r-stan AS trainer

# Set working directory
WORKDIR /app

# Copy project files
COPY . /app/

# Create necessary directories with appropriate permissions
RUN mkdir -p \
    /app/models/bayesian \
    /app/models/xgboost \
    /app/models/bnn_multioutput_checkpoints \
    /app/logs/training \
    /app/data/processed \
    /app/cache \
    && chmod -R 777 /app/models /app/logs /app/cache

# Environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    # CUDA configuration
    CUDA_HOME=/usr/local/cuda \
    CUDA_VISIBLE_DEVICES=0 \
    # PyTorch configuration
    TORCH_CUDA_ARCH_LIST="8.9" \
    # XGBoost configuration
    XGBOOST_ENABLE_GPU=1 \
    # Database connection (override in docker-compose)
    DATABASE_URL=postgresql://dro:sicillionbillions@localhost:5544/devdb01 \
    # Training configuration
    TRAINING_BATCH_SIZE=256 \
    TRAINING_WORKERS=4 \
    # R configuration
    R_LIBS_USER=/usr/local/lib/R/site-library

# Add CUDA to PATH
ENV PATH=/usr/local/cuda/bin:${PATH} \
    LD_LIBRARY_PATH=/usr/local/cuda/lib64:${LD_LIBRARY_PATH}

# Health check - verify GPU is accessible
HEALTHCHECK --interval=60s --timeout=30s --start-period=10s --retries=3 \
    CMD nvidia-smi && \
        python -c "import torch; assert torch.cuda.is_available()" && \
        python -c "import xgboost as xgb; assert xgb.build_info().get('USE_CUDA')" || exit 1

# Default command - keep container running
CMD ["tail", "-f", "/dev/null"]

# ============================================================================
# Build & Usage Instructions
# ============================================================================
#
# Build:
#   docker build -f containers/Dockerfile.gpu-trainer -t nfl-analytics-gpu-trainer .
#
# Run with docker-compose:
#   docker-compose -f docker-compose.gpu.yml up -d gpu-trainer
#
# Execute training job:
#   docker exec -it nfl-analytics-gpu-trainer python py/models/bnn_multioutput_pytorch.py --device cuda
#
# Interactive shell:
#   docker exec -it nfl-analytics-gpu-trainer bash
#
# Monitor GPU:
#   docker exec -it nfl-analytics-gpu-trainer nvidia-smi
#   docker exec -it nfl-analytics-gpu-trainer nvtop
#
# Check logs:
#   docker logs -f nfl-analytics-gpu-trainer
# ============================================================================
