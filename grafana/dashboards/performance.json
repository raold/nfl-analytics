{
  "dashboard": {
    "title": "NFL Props - Performance Dashboard",
    "tags": ["nfl", "props", "performance"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "Current ROI",
        "type": "gauge",
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "props_roi_total * 100",
            "refId": "A",
            "legendFormat": "ROI %"
          }
        ],
        "options": {
          "showThresholdLabels": false,
          "showThresholdMarkers": true
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": -10,
            "max": 15,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": -10, "color": "dark-red"},
                {"value": 0, "color": "dark-orange"},
                {"value": 3, "color": "dark-yellow"},
                {"value": 5, "color": "dark-green"},
                {"value": 7, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "Win Rate",
        "type": "gauge",
        "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0},
        "targets": [
          {
            "expr": "props_win_rate * 100",
            "refId": "A",
            "legendFormat": "Win Rate"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 40,
            "max": 65,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 40, "color": "dark-red"},
                {"value": 50, "color": "dark-orange"},
                {"value": 52, "color": "dark-yellow"},
                {"value": 54, "color": "dark-green"},
                {"value": 56, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "Sharpe Ratio",
        "type": "gauge",
        "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "props_sharpe_ratio",
            "refId": "A",
            "legendFormat": "Sharpe"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "min": 0,
            "max": 4,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "dark-red"},
                {"value": 1.0, "color": "dark-orange"},
                {"value": 1.5, "color": "dark-yellow"},
                {"value": 2.0, "color": "dark-green"},
                {"value": 2.5, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "title": "Total Profit",
        "type": "stat",
        "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0},
        "targets": [
          {
            "expr": "props_profit_total",
            "refId": "A",
            "legendFormat": "Total P&L"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": -1000, "color": "dark-red"},
                {"value": 0, "color": "dark-yellow"},
                {"value": 500, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 5,
        "title": "Cumulative Profit Over Time",
        "type": "graph",
        "gridPos": {"h": 9, "w": 24, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "props_profit_total",
            "refId": "A",
            "legendFormat": "Total P&L"
          },
          {
            "expr": "props_bankroll - 10000",
            "refId": "B",
            "legendFormat": "Profit (from $10k start)"
          }
        ],
        "xaxis": {"mode": "time"},
        "yaxes": [
          {"format": "currencyUSD", "label": "Profit ($)"},
          {"format": "short"}
        ],
        "lines": true,
        "fill": 1,
        "linewidth": 2,
        "pointradius": 2,
        "legend": {"show": true, "alignAsTable": true, "rightSide": true}
      },
      {
        "id": 6,
        "title": "ROI Trend (1h, 24h, 7d)",
        "type": "graph",
        "gridPos": {"h": 9, "w": 12, "x": 0, "y": 17},
        "targets": [
          {
            "expr": "props_roi_total * 100",
            "refId": "A",
            "legendFormat": "Current ROI"
          },
          {
            "expr": "avg_over_time(props_roi_total[1h]) * 100",
            "refId": "B",
            "legendFormat": "1h Avg"
          },
          {
            "expr": "avg_over_time(props_roi_total[24h]) * 100",
            "refId": "C",
            "legendFormat": "24h Avg"
          },
          {
            "expr": "avg_over_time(props_roi_total[7d]) * 100",
            "refId": "D",
            "legendFormat": "7d Avg"
          }
        ],
        "yaxes": [
          {"format": "percent", "label": "ROI (%)"},
          {"format": "short"}
        ],
        "alert": {
          "conditions": [
            {
              "evaluator": {"params": [0], "type": "lt"},
              "operator": {"type": "and"},
              "query": {"params": ["A", "6h", "now"]},
              "reducer": {"params": [], "type": "avg"},
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "frequency": "1m",
          "handler": 1,
          "name": "Negative ROI Alert",
          "noDataState": "no_data",
          "notifications": []
        }
      },
      {
        "id": 7,
        "title": "Win Rate by Stat Type",
        "type": "graph",
        "gridPos": {"h": 9, "w": 12, "x": 12, "y": 17},
        "targets": [
          {
            "expr": "rate(props_wins_total{stat_type=\"passing_yards\"}[1h]) / rate(props_bets_total{stat_type=\"passing_yards\"}[1h]) * 100",
            "refId": "A",
            "legendFormat": "Passing Yards"
          },
          {
            "expr": "rate(props_wins_total{stat_type=\"rushing_yards\"}[1h]) / rate(props_bets_total{stat_type=\"rushing_yards\"}[1h]) * 100",
            "refId": "B",
            "legendFormat": "Rushing Yards"
          },
          {
            "expr": "rate(props_wins_total{stat_type=\"receiving_yards\"}[1h]) / rate(props_bets_total{stat_type=\"receiving_yards\"}[1h]) * 100",
            "refId": "C",
            "legendFormat": "Receiving Yards"
          }
        ],
        "yaxes": [
          {"format": "percent", "label": "Win Rate (%)"},
          {"format": "short"}
        ]
      },
      {
        "id": 8,
        "title": "Recent Bets (Last 20)",
        "type": "table",
        "gridPos": {"h": 10, "w": 24, "x": 0, "y": 26},
        "targets": [
          {
            "expr": "changes(props_bets_total[5m])",
            "refId": "A",
            "legendFormat": "New Bets",
            "instant": false,
            "format": "table"
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {},
              "indexByName": {},
              "renameByName": {
                "Time": "Timestamp",
                "stat_type": "Prop Type",
                "Value": "Count"
              }
            }
          }
        ]
      },
      {
        "id": 9,
        "title": "Daily Performance Summary",
        "type": "stat",
        "gridPos": {"h": 4, "w": 8, "x": 0, "y": 36},
        "targets": [
          {
            "expr": "increase(props_bets_total[1d])",
            "refId": "A",
            "legendFormat": "Bets Today"
          },
          {
            "expr": "increase(props_wins_total[1d])",
            "refId": "B",
            "legendFormat": "Wins Today"
          },
          {
            "expr": "increase(props_profit_total[1d])",
            "refId": "C",
            "legendFormat": "Profit Today"
          }
        ]
      },
      {
        "id": 10,
        "title": "Weekly Performance Summary",
        "type": "stat",
        "gridPos": {"h": 4, "w": 8, "x": 8, "y": 36},
        "targets": [
          {
            "expr": "increase(props_bets_total[7d])",
            "refId": "A",
            "legendFormat": "Bets (7d)"
          },
          {
            "expr": "increase(props_wins_total[7d])",
            "refId": "B",
            "legendFormat": "Wins (7d)"
          },
          {
            "expr": "increase(props_profit_total[7d])",
            "refId": "C",
            "legendFormat": "Profit (7d)"
          }
        ]
      },
      {
        "id": 11,
        "title": "Monthly Performance Summary",
        "type": "stat",
        "gridPos": {"h": 4, "w": 8, "x": 16, "y": 36},
        "targets": [
          {
            "expr": "increase(props_bets_total[30d])",
            "refId": "A",
            "legendFormat": "Bets (30d)"
          },
          {
            "expr": "increase(props_wins_total[30d])",
            "refId": "B",
            "legendFormat": "Wins (30d)"
          },
          {
            "expr": "increase(props_profit_total[30d])",
            "refId": "C",
            "legendFormat": "Profit (30d)"
          }
        ]
      }
    ]
  }
}
