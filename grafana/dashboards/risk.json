{
  "dashboard": {
    "title": "NFL Props - Risk Management Dashboard",
    "tags": ["nfl", "props", "risk", "drawdown"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "Current Exposure (% of Bankroll)",
        "type": "gauge",
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "(props_exposure_total / props_bankroll) * 100",
            "refId": "A",
            "legendFormat": "Exposure %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 40, "color": "dark-green"},
                {"value": 60, "color": "yellow"},
                {"value": 80, "color": "orange"},
                {"value": 90, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "Current Drawdown (Target: <12%)",
        "type": "gauge",
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
        "targets": [
          {
            "expr": "props_drawdown_current * 100",
            "refId": "A",
            "legendFormat": "Drawdown %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 20,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 5, "color": "dark-green"},
                {"value": 8, "color": "yellow"},
                {"value": 12, "color": "orange"},
                {"value": 15, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "Max Drawdown (All-Time)",
        "type": "gauge",
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
        "targets": [
          {
            "expr": "props_drawdown_max * 100",
            "refId": "A",
            "legendFormat": "Max DD %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 20,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 8, "color": "yellow"},
                {"value": 12, "color": "orange"},
                {"value": 15, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "title": "Drawdown Curve (Current and Max)",
        "type": "graph",
        "gridPos": {"h": 10, "w": 24, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "props_drawdown_current * 100",
            "refId": "A",
            "legendFormat": "Current Drawdown %"
          },
          {
            "expr": "props_drawdown_max * 100",
            "refId": "B",
            "legendFormat": "Max Drawdown %"
          }
        ],
        "yaxes": [
          {"format": "percent", "label": "Drawdown (%)", "min": 0},
          {"format": "short"}
        ],
        "lines": true,
        "fill": 2,
        "linewidth": 2,
        "alert": {
          "conditions": [
            {
              "evaluator": {"params": [15], "type": "gt"},
              "operator": {"type": "and"},
              "query": {"params": ["B", "5m", "now"]},
              "reducer": {"params": [], "type": "max"},
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "frequency": "30s",
          "handler": 1,
          "name": "KILL SWITCH: Severe Drawdown",
          "noDataState": "no_data"
        },
        "thresholds": [
          {
            "value": 15,
            "colorMode": "critical",
            "fill": true,
            "line": true,
            "op": "gt"
          }
        ]
      },
      {
        "id": 5,
        "title": "Bankroll vs Exposure Over Time",
        "type": "graph",
        "gridPos": {"h": 9, "w": 12, "x": 0, "y": 18},
        "targets": [
          {
            "expr": "props_bankroll",
            "refId": "A",
            "legendFormat": "Bankroll ($)"
          },
          {
            "expr": "props_exposure_total",
            "refId": "B",
            "legendFormat": "Exposure ($)"
          }
        ],
        "yaxes": [
          {"format": "currencyUSD", "label": "Amount ($)"},
          {"format": "short"}
        ],
        "lines": true,
        "fill": 1,
        "stack": false
      },
      {
        "id": 6,
        "title": "Open Positions Count",
        "type": "graph",
        "gridPos": {"h": 9, "w": 12, "x": 12, "y": 18},
        "targets": [
          {
            "expr": "props_open_positions",
            "refId": "A",
            "legendFormat": "Open Positions"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Count", "decimals": 0},
          {"format": "short"}
        ],
        "bars": true,
        "lines": false
      },
      {
        "id": 7,
        "title": "Top 5 Largest Positions",
        "type": "table",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 27},
        "targets": [
          {
            "expr": "props_position_largest",
            "refId": "A",
            "format": "table",
            "instant": true
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "renameByName": {
                "Value": "Position Size ($)"
              }
            }
          }
        ]
      },
      {
        "id": 8,
        "title": "Stop-Loss Status",
        "type": "stat",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 27},
        "targets": [
          {
            "expr": "props_stop_loss_triggered",
            "refId": "A",
            "legendFormat": "Stop Loss"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"type": "value", "value": "0", "text": "ACTIVE"},
              {"type": "value", "value": "1", "text": "TRIGGERED"}
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 1, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 9,
        "title": "Risk Metrics Summary",
        "type": "stat",
        "gridPos": {"h": 6, "w": 24, "x": 0, "y": 35},
        "targets": [
          {
            "expr": "props_exposure_total",
            "refId": "A",
            "legendFormat": "Total Exposure"
          },
          {
            "expr": "props_open_positions",
            "refId": "B",
            "legendFormat": "Open Positions"
          },
          {
            "expr": "props_position_largest",
            "refId": "C",
            "legendFormat": "Largest Position"
          },
          {
            "expr": "(props_exposure_total / props_bankroll) * 100",
            "refId": "D",
            "legendFormat": "Exposure %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD"
          },
          "overrides": [
            {
              "matcher": {"id": "byName", "options": "Open Positions"},
              "properties": [{"id": "unit", "value": "short"}]
            },
            {
              "matcher": {"id": "byName", "options": "Exposure %"},
              "properties": [{"id": "unit", "value": "percent"}]
            }
          ]
        }
      },
      {
        "id": 10,
        "title": "Daily Loss Monitoring (>3% Threshold)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 41},
        "targets": [
          {
            "expr": "-(increase(props_profit_total[1d]) / props_bankroll) * 100",
            "refId": "A",
            "legendFormat": "Daily Loss %"
          }
        ],
        "yaxes": [
          {"format": "percent", "label": "Loss %"},
          {"format": "short"}
        ],
        "alert": {
          "conditions": [
            {
              "evaluator": {"params": [3], "type": "gt"},
              "operator": {"type": "and"},
              "query": {"params": ["A", "1h", "now"]},
              "reducer": {"params": [], "type": "avg"},
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "frequency": "1h",
          "handler": 1,
          "name": "Daily Loss >3%",
          "noDataState": "no_data"
        },
        "thresholds": [
          {
            "value": 3,
            "colorMode": "critical",
            "fill": false,
            "line": true,
            "op": "gt"
          }
        ]
      }
    ]
  }
}
