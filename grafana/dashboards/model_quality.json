{
  "dashboard": {
    "title": "NFL Props - Model Quality Dashboard",
    "tags": ["nfl", "props", "model", "calibration"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "1m",
    "panels": [
      {
        "id": 1,
        "title": "BNN Calibration Coverage (Target: 85-95%)",
        "type": "gauge",
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "props_calibration_coverage * 100",
            "refId": "A",
            "legendFormat": "Calibration %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 70,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 70, "color": "dark-red"},
                {"value": 75, "color": "red"},
                {"value": 80, "color": "orange"},
                {"value": 85, "color": "green"},
                {"value": 95, "color": "orange"},
                {"value": 98, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "MAE - Passing Yards (Target: <65)",
        "type": "gauge",
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
        "targets": [
          {
            "expr": "props_prediction_mae{stat_type=\"passing_yards\"}",
            "refId": "A",
            "legendFormat": "MAE"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 55, "color": "dark-green"},
                {"value": 65, "color": "orange"},
                {"value": 75, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "MAE - Rushing Yards (Target: <40)",
        "type": "gauge",
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
        "targets": [
          {
            "expr": "props_prediction_mae{stat_type=\"rushing_yards\"}",
            "refId": "A",
            "legendFormat": "MAE"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "min": 0,
            "max": 60,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 30, "color": "dark-green"},
                {"value": 40, "color": "orange"},
                {"value": 50, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "title": "Calibration Coverage Over Time",
        "type": "graph",
        "gridPos": {"h": 9, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "props_calibration_coverage * 100",
            "refId": "A",
            "legendFormat": "Coverage %"
          }
        ],
        "yaxes": [
          {"format": "percent", "label": "Coverage", "min": 70, "max": 100},
          {"format": "short"}
        ],
        "lines": true,
        "fill": 2,
        "linewidth": 2,
        "alert": {
          "conditions": [
            {
              "evaluator": {"params": [0.75, 0.99], "type": "outside_range"},
              "operator": {"type": "and"},
              "query": {"params": ["A", "24h", "now"]},
              "reducer": {"params": [], "type": "avg"},
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "frequency": "1h",
          "handler": 1,
          "name": "Calibration Failure Alert",
          "noDataState": "no_data"
        },
        "thresholds": [
          {
            "value": 85,
            "colorMode": "custom",
            "fill": true,
            "line": true,
            "op": "gt",
            "fillColor": "rgba(50, 172, 45, 0.2)",
            "lineColor": "rgba(50, 172, 45, 1)"
          },
          {
            "value": 95,
            "colorMode": "custom",
            "fill": true,
            "line": true,
            "op": "lt",
            "fillColor": "rgba(50, 172, 45, 0.2)",
            "lineColor": "rgba(50, 172, 45, 1)"
          }
        ]
      },
      {
        "id": 5,
        "title": "MAE Over Time (by Stat Type)",
        "type": "graph",
        "gridPos": {"h": 9, "w": 12, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "props_prediction_mae{stat_type=\"passing_yards\"}",
            "refId": "A",
            "legendFormat": "Passing Yards"
          },
          {
            "expr": "props_prediction_mae{stat_type=\"rushing_yards\"}",
            "refId": "B",
            "legendFormat": "Rushing Yards"
          },
          {
            "expr": "props_prediction_mae{stat_type=\"receiving_yards\"}",
            "refId": "C",
            "legendFormat": "Receiving Yards"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "MAE (yards)"},
          {"format": "short"}
        ],
        "thresholds": [
          {
            "value": 65,
            "colorMode": "critical",
            "fill": false,
            "line": true,
            "op": "gt"
          }
        ]
      },
      {
        "id": 6,
        "title": "Prediction Uncertainty Distribution",
        "type": "graph",
        "gridPos": {"h": 9, "w": 12, "x": 0, "y": 17},
        "targets": [
          {
            "expr": "props_uncertainty_mean{stat_type=\"passing_yards\"}",
            "refId": "A",
            "legendFormat": "Passing - Mean Uncertainty"
          },
          {
            "expr": "props_uncertainty_mean{stat_type=\"rushing_yards\"}",
            "refId": "B",
            "legendFormat": "Rushing - Mean Uncertainty"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Uncertainty (yards)"},
          {"format": "short"}
        ],
        "lines": true,
        "bars": false,
        "fill": 1
      },
      {
        "id": 7,
        "title": "Predictions Generated (Rate)",
        "type": "graph",
        "gridPos": {"h": 9, "w": 12, "x": 12, "y": 17},
        "targets": [
          {
            "expr": "rate(props_predictions_total[5m])",
            "refId": "A",
            "legendFormat": "{{stat_type}}"
          }
        ],
        "yaxes": [
          {"format": "ops", "label": "Predictions/sec"},
          {"format": "short"}
        ]
      },
      {
        "id": 8,
        "title": "Feature Drift Detection",
        "type": "heatmap",
        "gridPos": {"h": 10, "w": 24, "x": 0, "y": 26},
        "targets": [
          {
            "expr": "props_feature_drift",
            "refId": "A",
            "legendFormat": "{{feature_name}}",
            "format": "time_series"
          }
        ],
        "dataFormat": "timeseries",
        "yAxis": {
          "format": "short",
          "decimals": 0
        },
        "color": {
          "mode": "spectrum",
          "cardColor": "#b4ff00",
          "colorScale": "sqrt",
          "exponent": 0.5,
          "colorScheme": "interpolateRdYlGn"
        }
      },
      {
        "id": 9,
        "title": "Model Metadata",
        "type": "table",
        "gridPos": {"h": 6, "w": 12, "x": 0, "y": 36},
        "targets": [
          {
            "expr": "props_model_version",
            "refId": "A",
            "format": "table",
            "instant": true
          }
        ]
      },
      {
        "id": 10,
        "title": "Prediction vs Actual (Last 100)",
        "type": "graph",
        "gridPos": {"h": 6, "w": 12, "x": 12, "y": 36},
        "targets": [
          {
            "expr": "props_prediction_mae",
            "refId": "A",
            "legendFormat": "Error"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Absolute Error"},
          {"format": "short"}
        ],
        "points": true,
        "pointradius": 3
      }
    ]
  }
}
