{
  "dashboard": {
    "title": "NFL Props - Operations Dashboard",
    "tags": ["nfl", "props", "operations", "latency"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "15s",
    "panels": [
      {
        "id": 1,
        "title": "Prediction Latency (p50, p95, p99)",
        "type": "graph",
        "gridPos": {"h": 9, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(props_prediction_latency_seconds_bucket[5m]))",
            "refId": "A",
            "legendFormat": "p50"
          },
          {
            "expr": "histogram_quantile(0.95, rate(props_prediction_latency_seconds_bucket[5m]))",
            "refId": "B",
            "legendFormat": "p95"
          },
          {
            "expr": "histogram_quantile(0.99, rate(props_prediction_latency_seconds_bucket[5m]))",
            "refId": "C",
            "legendFormat": "p99"
          }
        ],
        "yaxes": [
          {"format": "s", "label": "Latency"},
          {"format": "short"}
        ],
        "lines": true,
        "fill": 1,
        "alert": {
          "conditions": [
            {
              "evaluator": {"params": [1.0], "type": "gt"},
              "operator": {"type": "and"},
              "query": {"params": ["B", "15m", "now"]},
              "reducer": {"params": [], "type": "avg"},
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "frequency": "1m",
          "handler": 1,
          "name": "High Prediction Latency",
          "noDataState": "no_data"
        },
        "thresholds": [
          {
            "value": 0.5,
            "colorMode": "custom",
            "fill": false,
            "line": true,
            "op": "gt",
            "lineColor": "rgba(237, 129, 40, 0.8)"
          }
        ]
      },
      {
        "id": 2,
        "title": "Bet Placement Success Rate",
        "type": "gauge",
        "gridPos": {"h": 9, "w": 6, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "(1 - (rate(props_errors_total{error_type=\"bet_placement\"}[5m]) / rate(props_bets_total[5m]))) * 100",
            "refId": "A",
            "legendFormat": "Success %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 90, "color": "orange"},
                {"value": 95, "color": "yellow"},
                {"value": 98, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "API Health Check",
        "type": "stat",
        "gridPos": {"h": 9, "w": 6, "x": 18, "y": 0},
        "targets": [
          {
            "expr": "up{job=\"nfl_analytics_api\"}",
            "refId": "A",
            "legendFormat": "API Status"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"type": "value", "value": "0", "text": "DOWN"},
              {"type": "value", "value": "1", "text": "UP"}
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 1, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "title": "Database Query Performance",
        "type": "graph",
        "gridPos": {"h": 9, "w": 12, "x": 0, "y": 9},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(props_database_query_seconds_bucket{query_type=\"feature_generation\"}[5m]))",
            "refId": "A",
            "legendFormat": "Feature Generation (p95)"
          },
          {
            "expr": "histogram_quantile(0.95, rate(props_database_query_seconds_bucket{query_type=\"odds_fetch\"}[5m]))",
            "refId": "B",
            "legendFormat": "Odds Fetch (p95)"
          },
          {
            "expr": "histogram_quantile(0.95, rate(props_database_query_seconds_bucket{query_type=\"player_stats\"}[5m]))",
            "refId": "C",
            "legendFormat": "Player Stats (p95)"
          }
        ],
        "yaxes": [
          {"format": "s", "label": "Query Time"},
          {"format": "short"}
        ]
      },
      {
        "id": 5,
        "title": "Feature Generation Latency",
        "type": "graph",
        "gridPos": {"h": 9, "w": 12, "x": 12, "y": 9},
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(props_feature_generation_seconds_bucket[5m]))",
            "refId": "A",
            "legendFormat": "p50"
          },
          {
            "expr": "histogram_quantile(0.95, rate(props_feature_generation_seconds_bucket[5m]))",
            "refId": "B",
            "legendFormat": "p95"
          }
        ],
        "yaxes": [
          {"format": "s", "label": "Latency"},
          {"format": "short"}
        ]
      },
      {
        "id": 6,
        "title": "Predictions Generated per Hour",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 18},
        "targets": [
          {
            "expr": "rate(props_predictions_total[1h]) * 3600",
            "refId": "A",
            "legendFormat": "{{stat_type}}"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Predictions/hour"},
          {"format": "short"}
        ],
        "bars": true
      },
      {
        "id": 7,
        "title": "Error Rate by Type",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 18},
        "targets": [
          {
            "expr": "rate(props_errors_total[5m])",
            "refId": "A",
            "legendFormat": "{{error_type}}"
          }
        ],
        "yaxes": [
          {"format": "ops", "label": "Errors/sec"},
          {"format": "short"}
        ],
        "alert": {
          "conditions": [
            {
              "evaluator": {"params": [0.05], "type": "gt"},
              "operator": {"type": "and"},
              "query": {"params": ["A", "10m", "now"]},
              "reducer": {"params": [], "type": "avg"},
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "frequency": "1m",
          "handler": 1,
          "name": "High Error Rate (>5%)",
          "noDataState": "no_data"
        }
      },
      {
        "id": 8,
        "title": "System Resource Utilization",
        "type": "graph",
        "gridPos": {"h": 9, "w": 12, "x": 0, "y": 26},
        "targets": [
          {
            "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
            "refId": "A",
            "legendFormat": "Memory %"
          },
          {
            "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
            "refId": "B",
            "legendFormat": "CPU %"
          },
          {
            "expr": "(1 - (node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"})) * 100",
            "refId": "C",
            "legendFormat": "Disk %"
          }
        ],
        "yaxes": [
          {"format": "percent", "label": "Usage %", "min": 0, "max": 100},
          {"format": "short"}
        ],
        "thresholds": [
          {
            "value": 85,
            "colorMode": "critical",
            "fill": false,
            "line": true,
            "op": "gt"
          }
        ]
      },
      {
        "id": 9,
        "title": "Database Connection Status",
        "type": "stat",
        "gridPos": {"h": 9, "w": 6, "x": 12, "y": 26},
        "targets": [
          {
            "expr": "up{job=\"postgres\"}",
            "refId": "A",
            "legendFormat": "PostgreSQL"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"type": "value", "value": "0", "text": "DOWN"},
              {"type": "value", "value": "1", "text": "UP"}
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 1, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 10,
        "title": "Model Loading Time",
        "type": "stat",
        "gridPos": {"h": 9, "w": 6, "x": 18, "y": 26},
        "targets": [
          {
            "expr": "props_model_load_seconds",
            "refId": "A",
            "legendFormat": "Load Time"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 5, "color": "yellow"},
                {"value": 10, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 11,
        "title": "Request Rate by Endpoint",
        "type": "graph",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 35},
        "targets": [
          {
            "expr": "rate(props_requests_total[5m])",
            "refId": "A",
            "legendFormat": "{{endpoint}}"
          }
        ],
        "yaxes": [
          {"format": "reqps", "label": "Requests/sec"},
          {"format": "short"}
        ],
        "stack": true,
        "fill": 2
      }
    ]
  }
}
