      "type": "bargauge",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 39
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT season::text as season, AVG(abs_prediction_error) as mae FROM ml.predictions WHERE stat_type = 'passing_yards' AND actual_value IS NOT NULL GROUP BY season ORDER BY season;",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "postgres",
        "uid": "postgres_nfl"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": 0,
                "color": "green"
              },
              {
                "value": 40,
                "color": "yellow"
              },
              {
                "value": 50,
                "color": "red"
              }
            ]
          }
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      }
    },
    {
