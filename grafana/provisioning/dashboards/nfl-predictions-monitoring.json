      "title": "Win Rate by Season (%)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 39
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT season, 100.0 * AVG(CASE WHEN status = 'win' THEN 1.0 ELSE 0.0 END) as win_rate FROM ml.predictions WHERE stat_type = 'passing_yards' AND actual_value IS NOT NULL GROUP BY season ORDER BY season;",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "postgres",
        "uid": "postgres_nfl"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "none",
            "showPoints": "auto",
            "axisPlacement": "auto"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": 0,
                "color": "red"
              },
              {
                "value": 55,
                "color": "yellow"
              },
              {
                "value": 59,
                "color": "green"
              }
            ]
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "single"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ]
}
